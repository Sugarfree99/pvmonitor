# Tvinga LF på filer som körs/läses på Linux (Debian/Beelink).
# CRLF i shell-skript orsakar annars "bad interpreter"-fel.
*.sh            text eol=lf
*.service       text eol=lf
*.conf          text eol=lf
install.sh      text eol=lf
openbox-autostart.sh text eol=lf

# Låt Git hantera övriga textfiler normalt
* text=auto
