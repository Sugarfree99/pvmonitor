# =============================================================================
# backend/.env  –  körtidskonfiguration OCH känsliga uppgifter
#
# Kopiera denna fil till backend/.env och fyll i värdena.
# .env är gitignorerad och committas ALDRIG. På Beelink: chmod 600 (endast
# kiosk-användaren kan läsa den). systemd laddar den via EnvironmentFile.
# =============================================================================

# ---- Nätverk / API ----------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# ---- Pollning ---------------------------------------------------------------
POLL_INTERVAL_MS=10000

# Vilken omformar-konfiguration som ska användas.
#   config/inverters.json      = produktion (riktiga IP-adresser)
#   config/inverters.sim.json  = simulator (lokal Modbus-server)
# Lämna tom för standard (config/inverters.json).
# INVERTERS_CONFIG=config/inverters.sim.json

# ---- Lagring ----------------------------------------------------------------
# SQLite på RAM-disk (tmpfs) + periodisk backup till beständig disk
DB_PATH=/dev/shm/pvmonitor/pvmonitor.sqlite
DB_BACKUP_PATH=/opt/pvmonitor/backend/data/pvmonitor.sqlite
# Hur ofta RAM-databasen backas till disk (ms). Lägre = mindre lucka i
# timdiagrammet vid strömavbrott, men fler disk-skrivningar. Default 15000.
DB_BACKUP_INTERVAL_MS=15000

# ---- Simuleringsläge --------------------------------------------------------
# 1 = enkel syntetisk data utan Modbus (fallback). Föredra hellre simulatorn
# (npm run dev:sim) som testar den riktiga Modbus-koden.
MOCK=0

# ---- Admin-gränssnitt -------------------------------------------------------
# Lösenord till http://<ip>:3000/admin. Två roller stöds:
#   admin      – får redigera omformare (namn/IP/port/kapacitet, i/ur drift)
#   superadmin – får dessutom ändra CO2-faktor och lägga till/ta bort anläggningar
# Lämna tomt för att stänga av respektive konto. Användarnamn kan sättas separat.
ADMIN_USER=admin
ADMIN_PASSWORD=
SUPERADMIN_USER=superadmin
SUPERADMIN_PASSWORD=
# Valfri extra hemlighet för att signera sessions-cookies (annars härleds den ur lösenorden).
SESSION_SECRET=

# =============================================================================
# KÄNSLIGA UPPGIFTER (fyll i vid behov – lämna tomma om de inte används)
# -----------------------------------------------------------------------------
# Modbus TCP är i normalfallet OAUTENTISERAT, så omformarna kräver oftast inga
# inloggningsuppgifter. Lägg ändå ALL känslig data här (aldrig i inverters.json,
# som är versionshanterad).
# =============================================================================

# Ev. inloggning till omformarnas webbgränssnitt (om framtida funktion kräver det)
# KOSTAL_SOS1_PASSWORD=
# KOSTAL_SOS2_PASSWORD=
# KOSTAL_RSYD1_PASSWORD=

# Ev. API-nyckel/token för moln- eller portaltjänst
# KOSTAL_API_TOKEN=

# Ev. auth-nyckel för fjärraccess (t.ex. Tailscale). Föredra dock att lagra
# denna i tjänstens eget säkra förvar i stället för här.
# TAILSCALE_AUTHKEY=
