[Unit]
Description=PV Monitor KOSTAL Modbus-simulator (endast före driftsättning)
Documentation=https://github.com/Sugarfree99/pvmonitor
After=network.target

[Service]
Type=simple
User=kiosk
WorkingDirectory=/opt/pvmonitor/backend
ExecStart=/usr/bin/node sim/kostalSimulator.js
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=multi-user.target
